# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# Local project data (user-generated content, not source)
data/projects/

# OS / editor
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings & installed skill cache
.claude/settings.local.json
.claude/skills/
.agents/
skills-lock.json

# Local Python TTS runtime (mlx-audio venv + HF model cache) — set up via python/tts/setup.sh, machine-specific
python/tts/.venv/
python/tts/_probe.py
