# LLM
LLM_PROVIDER=deepseek        # deepseek | hchat-claude | hchat-chatgpt | hchat-gemini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ACCURATE=     # optional override, default deepseek-v4-pro
DEEPSEEK_MODEL_FAST=         # optional override, default deepseek-v4-flash
DEEPSEEK_STREAM_IDLE_TIMEOUT_MS=  # optional, default 120000 — abort a streaming call if no bytes arrive for this long (idle, not total)

# Image
IMAGE_PROVIDER=openai        # openai | hchat-gemini | fal — used for single-scene regeneration (1 image at a time)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=          # currently unused by the client (model is a fixed constant); reserved for a future override

# fal.ai (IMAGE_PROVIDER=fal) — text→image via the queue REST API
FAL_KEY=
FAL_IMAGE_MODEL=             # optional override, default fal-ai/flux/schnell (e.g. google/nano-banana-2-lite)
                             # nano-banana-* models take aspect_ratio (derived from size) instead of image_size

# Batch image generation (2+ scenes at once) — separate provider from IMAGE_PROVIDER above.
IMAGE_BATCH_PROVIDER=none    # none | gemini — gemini uses Google's real (async) Gemini Batch API instead of
                             # calling IMAGE_PROVIDER repeatedly. Async by design (minutes to up to 24h, cheaper
                             # than real-time calls) — see lib/ai/image/geminiBatch.ts and the batch status panel
                             # in the images step UI.
GEMINI_API_KEY=              # https://aistudio.google.com/apikey — direct Google Gemini API key (not H-CHAT, not fal)
GEMINI_BATCH_IMAGE_MODEL=    # optional override, default gemini-3.1-flash-lite-image ("Nano Banana 2 Lite")

# H-CHAT (internal gateway — shared by all hchat-* LLM and image providers)
HCHAT_KEY=
HCHAT_BASE_URL=                  # optional override, default https://internal-apigw-kr.hmg-corp.io/hchat-in/api/v3
HCHAT_CLAUDE_MODEL_ACCURATE=     # optional override, default claude-sonnet-5
HCHAT_CLAUDE_MODEL_FAST=         # optional override, default claude-haiku-4-5
HCHAT_CHATGPT_MODEL_ACCURATE=    # optional override, default gpt-5.6-terra
HCHAT_CHATGPT_MODEL_FAST=        # optional override, default gpt-5.6-luna
HCHAT_GEMINI_MODEL_ACCURATE=     # optional override, default gemini-3.6-flash
HCHAT_GEMINI_MODEL_FAST=         # optional override, default gemini-3.5-flash-lite
HCHAT_GEMINI_IMAGE_MODEL=        # optional override, default gemini-3.1-flash-image
